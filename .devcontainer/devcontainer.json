{
  "name": "KasmVNC Desktop",
  "image": "mcr.microsoft.com/devcontainers/base:debian",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

  "forwardPorts": [6080],

  "portsAttributes": {
    "6080": {
      "label": "Kasm Desktop",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },

  "postCreateCommand": "bash .devcontainer/install.sh || true",

  "postStartCommand": "chmod +x .devcontainer/*.sh && bash .devcontainer/start.sh",

  "remoteUser": "vscode",
  "runArgs": ["--shm-size=2gb"]
}